# Copiar a .env (no se commitea) o exportar estas variables en la terminal antes de correr la app.

# Nombre logico de esta instancia (para diferenciarla al correr 2 procesos en local)
INSTANCE_NAME=service-a
# Puerto en el que levanta esta instancia
PORT=8080
# URL base del otro servicio a llamar desde /api/call-other (sin barra final)
OTHER_SERVICE_URL=http://localhost:8081

# Token de la Source creada en Better Stack (Logs > Sources > Connect source > Java).
# Si se deja vacia, la app arranca igual pero solo loguea por consola.
BETTERSTACK_SOURCE_TOKEN=
# Ingesting host de esa Source (lo muestra el dashboard o la API al listar sources).
# Las sources nuevas usan un host dedicado tipo sXXXXX.<region>.betterstackdata.com,
# no el generico in.logs.betterstack.com (que es el default si se deja vacio).
BETTERSTACK_INGEST_URL=
