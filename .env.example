# Copiar a .env (no se commitea) o exportar estas variables en la terminal antes de correr la app.

# Nombre logico de esta instancia (para diferenciarla al correr 2 procesos en local)
INSTANCE_NAME=service-a
# Puerto en el que levanta esta instancia
PORT=8080
# URL base del otro servicio a llamar desde /api/call-other (sin barra final)
OTHER_SERVICE_URL=http://localhost:8081

# API Key de Datadog (Organization Settings > API Keys > New Key).
# Si se deja vacia, la app arranca igual pero solo loguea por consola.
DATADOG_API_KEY=
# Site de la cuenta de Datadog (datadoghq.com=US1, datadoghq.eu=EU1, us3.datadoghq.com=US3, etc.).
# Se ve en la URL del dashboard. Default de este proyecto: us5.datadoghq.com (US5).
DATADOG_SITE=
# (Opcional) Forza el valor del tag env en los logs. Si no se setea:
#   - en Render se usa "produccion" automaticamente (Render expone la env var RENDER=true)
#   - en local se usa "local"
APP_ENV=
