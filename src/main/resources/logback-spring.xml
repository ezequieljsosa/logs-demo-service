<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      %logger{36} ya muestra la clase. %method:%line agregan el metodo y la linea
      exactos desde donde se llamo al logger. OJO: esto obliga a Logback a generar
      un stacktrace en CADA linea de log para poder ubicar el caller (~overhead
      chico pero real, no gratis). Para una demo/TP esta perfecto; en un servicio
      de alto trafico en produccion normalmente se evita.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36}.%method:%line [trace=%X{traceId} instance=%X{instanceId} req=%X{requestId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      A diferencia de Better Stack, este appender no depende de un <if> de Logback:
      DatadogHttpAppender arranca en modo no-op el mismo si falta DATADOG_API_KEY
      (ver start() en la clase), asi que se puede referenciar siempre desde <root>
      sin condicional ni la dependencia de Janino que eso requeria.
    -->
    <appender name="DATADOG" class="ar.edu.dds.logsdemo.DatadogHttpAppender">
        <service>${APP_NAME:-logs-demo-service}</service>
    </appender>

    <!-- Async para que un intake lento de Datadog no bloquee el thread que loguea. -->
    <appender name="DATADOG_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="DATADOG"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DATADOG_ASYNC"/>
    </root>

</configuration>
